# Database Environment Variables
DB_URL=jdbc:mysql://localhost:3306/leak_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# Gmail SMTP Configuration
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_16_character_gmail_app_password

# VNPT CTIP API
CTIP_API_URL=http://localhost:8080
CTIP_API_KEY=your_ctip_api_key_here

# VNPT SmartCA API
SMARTCA_API_URL=http://localhost:8080
SMARTCA_CLIENT_ID=your_smartca_client_id_here
SMARTCA_CLIENT_SECRET=your_smartca_client_secret_here

# Telegram Notification Bot
TELEGRAM_BOT_ENABLED=true
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_BOT_CHAT_ID=your_telegram_group_chat_id_here
